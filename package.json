{
  "name": "pricepulse-prototype",
  "version": "0.2.0",
  "private": true,
  "description": "PricePulse MVP prototype with Vite + React + TypeScript frontend and minimal Node API",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node api/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node prod-server.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
